	private void BindClientMethods()
	{
		HubConnection.BindMethod<string>(OnNotify);
		HubConnection.BindMethod<CommandArrayViewModel>(OnCommand);
		HubConnection.BindMethod<GameStateViewModel, StateUpdateReason>(OnGameStateUpdated);
		HubConnection.BindMethod<GameSummaryViewModel, StateUpdateReason>(OnGameSummaryUpdated);
		HubConnection.BindMethod<Guid>(OnGameDeleted);
		HubConnection.BindMethod<long, MatchmakingUpdateReason>(OnMatchmakingGameUpdated);
		HubConnection.BindMethod<PlayerResignedViewModel>(OnPlayerResigned);
		HubConnection.BindMethod<PlayerSkippedViewModel>(OnPlayerSkipped);
		HubConnection.BindMethod<Guid>(OnInvitation);
		HubConnection.BindMethod<LobbyGameViewModel>(OnLobbyInvitation);
		HubConnection.BindMethod<Guid>(OnGameReadyToStart);
		HubConnection.BindMethod<List<PolytopiaFriendViewModel>>(OnFriendsUpdated);
		HubConnection.BindMethod<Guid, PlayerStatus>(OnPlayerStatusUpdated);
		HubConnection.BindMethod<LobbyGameViewModel>(OnLobbyUpdated);
		HubConnection.BindMethod<PolytopiaUserViewModel>(OnUserUpdated);
		HubConnection.BindMethod<Guid>(OnFriendRequestReceived);
		HubConnection.BindMethod<Guid>(OnFriendRequestAccepted);
		HubConnection.BindMethod<int>(OnActionableGamesUpdated);
		HubConnection.BindMethod<TournamentViewModel, TournamentUpdateReason>(OnTournamentUpdated);
	}

	public abstract Task OnNotify(string message);

	public abstract Task OnCommand(CommandArrayViewModel model);

	public abstract Task OnGameStateUpdated(GameStateViewModel model, StateUpdateReason pushReason);

	public abstract Task OnGameSummaryUpdated(GameSummaryViewModel model, StateUpdateReason pushReason);

	public abstract Task OnGameDeleted(Guid gameId);

	public abstract Task OnMatchmakingGameUpdated(long gameId, MatchmakingUpdateReason pushReason);

	public abstract Task OnPlayerResigned(PlayerResignedViewModel playerResignedViewModel);

	public abstract Task OnPlayerSkipped(PlayerSkippedViewModel playerSkippedViewModel);

	public abstract Task OnInvitation(Guid gameId);

	public abstract Task OnLobbyInvitation(LobbyGameViewModel lobby);

	public abstract Task OnGameReadyToStart(Guid gameId);

	public abstract Task OnFriendsUpdated(List<PolytopiaFriendViewModel> friends);

	public abstract Task OnPlayerStatusUpdated(Guid playerId, PlayerStatus status);

	public abstract Task OnLobbyUpdated(LobbyGameViewModel lobby);

	public abstract Task OnUserUpdated(PolytopiaUserViewModel user);

	public abstract Task OnFriendRequestReceived(Guid frienduserId);

	public abstract Task OnFriendRequestAccepted(Guid frienduserId);

	public abstract Task OnActionableGamesUpdated(int count);

	public abstract Task OnTournamentUpdated(TournamentViewModel tournament, TournamentUpdateReason reason);

	protected void Log(object message, LogLevel level = (LogLevel)1)
	{
		//IL_0007: Unknown result type (might be due to invalid IL or missing references)
		//IL_0008: Unknown result type (might be due to invalid IL or missing references)
		Loggers.ForEach(delegate(ILogger logger)
		{
			//IL_0002: Unknown result type (might be due to invalid IL or missing references)
			LoggerExtensions.Log(logger, level, message.ToString(), Array.Empty<object>());
		});
	}

	public async Task LogStatus()
	{
		if (IsConnected)
		{
			Log("Connected to backend -> \n  Hubconnection: " + HubConnection.ConnectionId, (LogLevel)1);
		}
		else
		{
			Log("Not connected to game hub.", (LogLevel)1);
		}
		Log(await WhoAmI(), (LogLevel)1);
	}

