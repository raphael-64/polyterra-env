	public async Task<ServerResponse<ResponseViewModel>> UploadHighscores(UploadHighscoresBindingModel model)
	{
		Log("Uploading highscores.", (LogLevel)1);
		return await ServerResponseHelpers.ClientErrorHandledResponse(async delegate
		{
			bool useLZ4Compression = LZ4Options.UseLZ4Compression;
			UploadHighscoresBindingModel uploadHighscoresBindingModel = new UploadHighscoresBindingModel
			{
				InitialGameStateData = (useLZ4Compression ? LZ4Pickler.Pickle(model.InitialGameStateData, (LZ4Level)0) : model.InitialGameStateData),
				CurrentGameStateData = (useLZ4Compression ? LZ4Pickler.Pickle(model.CurrentGameStateData, (LZ4Level)0) : model.CurrentGameStateData),
				LZ4Compressed = useLZ4Compression
			};
			return await HubConnectionExtensions.InvokeAsync<ServerResponse<ResponseViewModel>>(HubConnection, "UploadHighscores", (object)uploadHighscoresBindingModel, default(CancellationToken));
		});
	}

	public async Task<ServerResponse<ResponseViewModel>> UploadHighscoresHttp(UploadHighscoresBindingModel model)
	{
		Log("Uploading highscores.", (LogLevel)1);
		if (!HasValidAccessToken())
		{
			await Login(connect: true, silent: true);
		}
		return await ServerResponseHelpers.ClientHttpErrorHandledResponse(async () => await BackendHttpClient.CallAsync<ServerResponse<ResponseViewModel>>(HttpMethod.Post, "api/game/upload_highscores", null, model));
	}

