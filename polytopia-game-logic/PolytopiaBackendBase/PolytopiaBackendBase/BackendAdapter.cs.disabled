	public async Task<ServerResponse<StartViewModel>> GetStartViewModel(StartBindingModel bindingModel)
	{
		if (!HasValidAccessToken())
		{
			await Login(connect: true, silent: true);
		}
		string path = "api/start/get_start_viewmodel";
		Log($"Getting start viewmodel. {BackendUri}{path}", (LogLevel)1);
		return await ServerResponseHelpers.ClientHttpErrorHandledResponse(async () => await BackendHttpClient.CallAsync<ServerResponse<StartViewModel>>(HttpMethod.Post, path, null, bindingModel));
	}

