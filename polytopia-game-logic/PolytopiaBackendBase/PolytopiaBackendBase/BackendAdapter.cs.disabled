	{
		Log("whoami", (LogLevel)1);
		return await ServerResponseHelpers.ClientHttpErrorHandledResponse(async () => await BackendHttpClient.CallAsync<ServerResponse<PolytopiaToken>>(HttpMethod.Get, "api/auth/whoami"));
	}

	private async Task HandleLoginResponse(ServerResponse<PolytopiaToken> response)
	{
		if (response.Success)
		{
			await HandleLoginResponse(response.Data);
		}
	}

	private async Task HandleLoginResponse(PolytopiaToken token)
	{
		if (token == null)
		{
			InvalidateToken();
			return;
		}
		ClientUserData = token;
		((HttpClient)BackendHttpClient).DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", ClientUserData.JwtToken);
		await StoreJwtToken(ClientUserData.JwtToken);
		await CacheUserProfileData(ClientUserData.User);
		Log(ClientUserData, (LogLevel)1);
	}

	private async Task SubscribeOnConnect()
	{
		await SubscribeToParticipatingGameSummaries();
		await SubscribeToFriends();
	}

	public async Task CloseConnection()
	{
		if (IsConnected)
		{
			await HubConnection.StopAsync(default(CancellationToken));
		}
		if (IsAuthenticated)
		{
			await Logout();
		}
	}

	public async Task<ServerResponse<ResponseViewModel>> Logout()
	{
		ClientUserData = null;
		return await ServerResponseHelpers.ClientHttpErrorHandledResponse(async () => await BackendHttpClient.CallAsync<ServerResponse<ResponseViewModel>>(HttpMethod.Post, "api/auth/logout"));
	}

