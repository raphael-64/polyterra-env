namespace PolytopiaBackendBase;

public abstract class BackendAdapter : IGameClient, IGameHub
{
	public BaseClient BackendHttpClient;

	public HubConnection HubConnection;

	public ConnectionStatus ConnectionStatus;

	public Uri BackendUri { get; private set; }

	public Uri GameHubUri => new Uri(BackendUri, "/gamehub");

	public PolytopiaToken ClientUserData { get; private set; }

	public bool IsConnected
	{
		get
		{
			HubConnection hubConnection = HubConnection;
			return ((hubConnection != null) ? hubConnection.ConnectionId : null) != null;
		}
	}

	public bool IsAuthenticated => HasValidAccessToken();

	public LogLevel SignalRLogLevel { get; private set; }

	private List<ILoggerProvider> LoggerProviders { get; set; }

	private List<ILogger> Loggers { get; set; }

	public LZ4Options LZ4Options { get; set; } = new LZ4Options();

	public BackendAdapter()
	{
		BackendUri = null;
		LoggerProviders = new List<ILoggerProvider>();
		SignalRLogLevel = (LogLevel)3;
		ConnectionStatus = ConnectionStatus.None;
	}

	public BackendAdapter UseBackendUri(Uri backendUri)
	{
		BackendUri = backendUri;
		return this;
	}

	public BackendAdapter UseLoggerProvider<TLoggerProvider>() where TLoggerProvider : ILoggerProvider, new()
	{
		LoggerProviders.Add((ILoggerProvider)(object)new TLoggerProvider());
		Loggers = LoggerProviders.Select((ILoggerProvider provider) => provider.CreateLogger("BackendAdapter")).ToList();
		return this;
	}

	public BackendAdapter ConfigureSignalRLogLevel(LogLevel logLevel)
	{
		//IL_0006: Unknown result type (might be due to invalid IL or missing references)
		//IL_0018: Unknown result type (might be due to invalid IL or missing references)
		Log($"Setting signalR LogLevel {logLevel}", (LogLevel)2);
		SignalRLogLevel = logLevel;
		return this;
	}

	public BackendAdapter UseHttpClient<THttpClient>() where THttpClient : BaseClient, new()
	{
		THttpClient val = new THttpClient();
		((HttpClient)val).BaseAddress = BackendUri;
		BackendHttpClient = val;
		return this;
	}

	public BackendAdapter ConfigureLZ4Compression(Action<LZ4Options> options)
	{
		if (options == null)
		{
			throw new ArgumentNullException("options");
		}
		options(LZ4Options);
		return this;
	}

	public BackendAdapter ConfigureHttpClient(Action<HttpClient> configureHttpClient)
	{
		if (configureHttpClient == null)
		{
			throw new ArgumentNullException("configureHttpClient");
		}
		configureHttpClient((HttpClient)(object)BackendHttpClient);
		return this;
	}

	public TBackendAdapter UseAs<TBackendAdapter>() where TBackendAdapter : BackendAdapter
	{
		Log($"Backendadapter set up using {BackendUri} (port: {BackendUri.Port})", (LogLevel)1);
		return this as TBackendAdapter;
	}

	public abstract Task Login(bool connect = true, bool silent = false);

	protected abstract Task CacheUserProfileData(PolytopiaUserViewModel polytopiaUserViewModel);

	protected abstract Task StoreJwtToken(string jwtToken);

	protected abstract Task<string> LoadJwtToken();

	public async Task Connect()
	{
		_ = 1;
		try
		{
			HubConnection = HubConnectionBuilderExtensions.WithAutomaticReconnect(HubConnectionBuilderExtensions.ConfigureLogging(NewtonsoftAotProtocolDependencyInjectionExtensions.AddNewtonsoftAotProtocol<IHubConnectionBuilder>(HubConnectionBuilderHttpExtensions.WithUrl((IHubConnectionBuilder)new HubConnectionBuilder(), GameHubUri, (Action<HttpConnectionOptions>)delegate(HttpConnectionOptions options)
			{
				options.AccessTokenProvider = AccessTokenProvider;
				options.SkipNegotiation = false;
			})), (Action<ILoggingBuilder>)delegate(ILoggingBuilder options)
			{
				//IL_0002: Unknown result type (might be due to invalid IL or missing references)
				LoggingBuilderExtensions.SetMinimumLevel(options, SignalRLogLevel);
				foreach (ILoggerProvider loggerProvider in LoggerProviders)
				{
					LoggingBuilderExtensions.AddProvider(options, loggerProvider);
				}
			})).Build();
			BindClientMethods();
			await HubConnection.StartAsync(default(CancellationToken));
			await SubscribeOnConnect();
			HubConnection.Reconnecting += OnReconnecting;
			HubConnection.Reconnected += OnReconnected;
			HubConnection.Closed += OnClosed;
		}
		catch (Exception ex)
		{
			Log("Could not connect to backend", (LogLevel)4);
			Log(ex, (LogLevel)5);
			throw ex;
		}
	}

	public async Task EnsureAuthenticatedAsync()
	{
		if (!IsAuthenticated)
		{
			InvalidateToken();
			await Login(connect: true, silent: true);
		}
	}

	private async Task<string> AccessTokenProvider()
	{
		Log("Entering AccessTokenProvider", (LogLevel)1);
		if (!HasValidAccessToken())
		{
			Log("Jwt token expired, logging in again", (LogLevel)1);
			InvalidateToken();
			await Login(connect: true, silent: true);
		}
		return ClientUserData?.JwtToken;
	}

	private bool HasValidAccessToken()
	{
		string obj = ClientUserData?.JwtToken;
		DateTime? dateTime = ClientUserData?.ExpiresAt;
		if (obj != null && dateTime.HasValue)
		{
			DateTime utcNow = DateTime.UtcNow;
			DateTime? dateTime2 = dateTime;
			return utcNow < dateTime2;
		}
		return false;
	}

	private void InvalidateToken()
	{
		if (ClientUserData != null)
		{
			ClientUserData.JwtToken = null;
			ClientUserData.ExpiresAt = null;
		}
	}

	public async Task<ServerResponse<PolytopiaToken>> LoginSteam(SteamLoginBindingModel model)
	{
		Log($"Login::Steam (handle={model.SteamAuthTicket.Handle})", (LogLevel)1);
		ServerResponse<PolytopiaToken> response = await ServerResponseHelpers.ClientHttpErrorHandledResponse(async () => await BackendHttpClient.CallAsync<ServerResponse<PolytopiaToken>>(HttpMethod.Post, "api/auth/login_steam", null, model));
		await HandleLoginResponse(response);
		return response;
	}

